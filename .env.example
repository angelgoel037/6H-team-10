# ==============================================================================
# CampusPilot — Environment Variable Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# DO NOT commit `.env.local` or any production secrets to source control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Public Anon Key: Safe for browser usage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only Service Role Key (NEVER expose to client code or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AI & Extraction Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: "mock" (default for offline dev/demo), "openai", "gemini", "anthropic"
AI_PROVIDER=mock
AI_API_KEY=your-ai-provider-api-key-here
AI_MODEL=gemini-1.5-pro
